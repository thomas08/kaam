# ค่าตั้งที่ ARCHITECTURE.md §3 ระบุว่าเป็นสัญญา ไม่ใช่คำแนะนำ
# แก้ค่าพวกนี้ต้องอัปเดตงบประมาณหน่วยความจำในเอกสารด้วย

CONFIG_PARTITION_TABLE_CUSTOM=y
CONFIG_PARTITION_TABLE_CUSTOM_FILENAME="partitions.csv"

# ---- PSRAM (8 MB Quad SPI) ----
CONFIG_SPIRAM=y
CONFIG_SPIRAM_MODE_QUAD=y
CONFIG_SPIRAM_SPEED_80M=y
CONFIG_SPIRAM_USE_MALLOC=y
# ก้อนที่ใหญ่กว่า 8 KB ตกไป PSRAM อัตโนมัติ
CONFIG_SPIRAM_MALLOC_ALWAYSINTERNAL=8192
CONFIG_SPIRAM_TRY_ALLOCATE_WIFI_LWIP=y

# ---- TLS: จุดที่ heap แตกบ่อยที่สุด ----
# คืน buffer หลัง handshake เสร็จ ลดจาก ~45 KB เหลือ ~8 KB ต่อเส้น
CONFIG_MBEDTLS_DYNAMIC_BUFFER=y
CONFIG_MBEDTLS_DYNAMIC_FREE_PEER_CERT=y
CONFIG_MBEDTLS_DYNAMIC_FREE_CONFIG_DATA=y
# ขาเข้าต้องใหญ่เพราะ record ของ provider ใหญ่ ขาออกเล็กได้
CONFIG_MBEDTLS_SSL_IN_CONTENT_LEN=16384
CONFIG_MBEDTLS_SSL_OUT_CONTENT_LEN=4096
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE=y
CONFIG_MBEDTLS_CERTIFICATE_BUNDLE_DEFAULT_FULL=y
CONFIG_MBEDTLS_CLIENT_SSL_SESSION_TICKETS=y

# ---- FreeRTOS: preemption ละเอียดขึ้นเพราะเป็น single core ----
CONFIG_FREERTOS_HZ=1000
CONFIG_ESP_TASK_WDT_EN=y
CONFIG_ESP_TASK_WDT_TIMEOUT_S=30
CONFIG_ESP_MAIN_TASK_STACK_SIZE=8192

# ---- lwIP ----
CONFIG_LWIP_TCP_SND_BUF_DEFAULT=8192
CONFIG_LWIP_TCP_WND_DEFAULT=8192
CONFIG_LWIP_MAX_SOCKETS=8

# ---- ระบบไฟล์ ----
CONFIG_ESP_TLS_INSECURE=n

# ---- ขนาด binary ----
CONFIG_COMPILER_OPTIMIZATION_SIZE=y
CONFIG_LOG_DEFAULT_LEVEL_INFO=y
CONFIG_ESP_SYSTEM_PANIC_PRINT_HALT=y
CONFIG_ESP_COREDUMP_ENABLE_TO_FLASH=y
CONFIG_ESP_COREDUMP_DATA_FORMAT_ELF=y

# ---- ความปลอดภัย (เปิดจริงตอน M8) ----
# CONFIG_SECURE_BOOT=y
# CONFIG_SECURE_FLASH_ENC_ENABLED=y
# CONFIG_NVS_ENCRYPTION=y
